# The K230D's Buildroot options on top of what the board gives: a system with
# DHCP on eth0 and a root login. The toolchain is not named here: the speed
# branch's default (Bootlin riscv64) applies, and the first build decides whether
# it builds the C908 code and the SDK U-Boot. The vendor Xuantie GCC 10 was a host
# path and waits on a fetchable URL (BR2_TOOLCHAIN_EXTERNAL_URL): coordinator's.
BR2_riscv=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ISA_RVV=y
BR2_TARGET_GENERIC_HOSTNAME="k230d-ai-cam"
BR2_TARGET_GENERIC_ISSUE="Welcome to the CanMV K230D AI-CAM"
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_DROPBEAR=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_PLAT="generic"
BR2_TARGET_OPENSBI_LINUX_PAYLOAD=y
# The vendor's FW_TEXT_START: fw_jump then jumps to 0x200000 (the kernel address U-Boot loads to).
BR2_TARGET_OPENSBI_ADDITIONAL_VARIABLES="FW_TEXT_START=0"
BR2_TARGET_UBOOT=y
BR2_TARGET_UBOOT_BOARDNAME="k230d_canmv_junroc_ai_cam"
BR2_TARGET_UBOOT_CUSTOM_VERSION=y
BR2_TARGET_UBOOT_CUSTOM_VERSION_VALUE="2022.10"
BR2_PACKAGE_HOST_EROFS_UTILS=y
BR2_PACKAGE_HOST_CRYPTSETUP=y
# U-Boot's host tools (the junroc config sets CONFIG_FIT_SIGNATURE: openssl/engine.h
# is needed on the host), and dtc, pylibfdt and pyelftools for its build. Buildroot's
# host packages supply them.
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y

# The kernel Image into the root filesystem's /boot, which the environment's
# bootcmd loads (ext4load mmc 1:1 /boot/Image). The device tree is the board's.
BR2_LINUX_KERNEL_INSTALL_TARGET=y
# The boot files the post-image makes beside the root image (post-image.sh).
BR2_ROOTFS_POST_IMAGE_SCRIPT="@here@/post-image.sh"
# The post-image receives the images dir first, then these: the staged k230-firstage
# tool (the board source k230-tool: a locked path tree, boards/k230d-ai-cam/board.toml).
BR2_ROOTFS_POST_SCRIPT_ARGS="@k230d-ai-cam.k230-tool@/k230-firstage"
