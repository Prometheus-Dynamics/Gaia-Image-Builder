# The K230D's Buildroot options on top of what the board gives: a system with
# DHCP on eth0 and a root login. The toolchain is not named here: the speed
# branch's default (Bootlin riscv64) applies, and the first build decides whether
# it builds the C908 code and the SDK U-Boot. The vendor Xuantie GCC 10 was a host
# path and waits on a fetchable URL (BR2_TOOLCHAIN_EXTERNAL_URL): coordinator's.
BR2_riscv=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ISA_RVV=y
BR2_TARGET_GENERIC_HOSTNAME="k230d-zero"
BR2_TARGET_GENERIC_ISSUE="Welcome to the CanMV K230D Zero"
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_DROPBEAR=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_PLAT="generic"
BR2_TARGET_UBOOT=y
BR2_PACKAGE_HOST_EROFS_UTILS=y
BR2_PACKAGE_HOST_CRYPTSETUP=y
# U-Boot's host tools (the junroc config sets CONFIG_FIT_SIGNATURE: openssl/engine.h
# is needed on the host), and dtc, pylibfdt and pyelftools for its build. Buildroot's
# host packages supply them.
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y
BR2_TARGET_UBOOT_NEEDS_DTC=y
BR2_TARGET_UBOOT_NEEDS_PYLIBFDT=y
BR2_TARGET_UBOOT_NEEDS_PYELFTOOLS=y
