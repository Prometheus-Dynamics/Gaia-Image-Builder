# The K230D's Buildroot options on top of what the board gives: a system with
# DHCP on eth0 and a root login. The toolchain is not named here: the speed
# branch's default (Bootlin riscv64) applies, and the first build decides whether
# it builds the C908 code and the SDK U-Boot. The vendor Xuantie GCC 10 was a host
# path and waits on a fetchable URL (BR2_TOOLCHAIN_EXTERNAL_URL): coordinator's.
BR2_riscv=y
BR2_RISCV_ISA_RVC=y
BR2_RISCV_ISA_RVV=y
BR2_TARGET_GENERIC_HOSTNAME="k230d-zero"
BR2_TARGET_GENERIC_ISSUE="Welcome to the CanMV K230D Zero"
BR2_SYSTEM_DHCP="eth0"
BR2_PACKAGE_BUSYBOX=y
BR2_PACKAGE_DROPBEAR=y
BR2_TARGET_OPENSBI=y
BR2_TARGET_OPENSBI_PLAT="generic"
BR2_TARGET_UBOOT=y
BR2_PACKAGE_HOST_EROFS_UTILS=y
# Interim: until the Rust verity lands (another worker); then this line goes.
# U-Boot's host tools need openssl/engine.h (the junroc config sets CONFIG_FIT_SIGNATURE);
# Buildroot's host OpenSSL supplies it. This U-Boot config has no binman and builds its own dtc.
BR2_TARGET_UBOOT_NEEDS_OPENSSL=y

# The bootloader's binaries into images/ for the family's wrapped areas (SPL, U-Boot,
# OpenSBI fw_jump.bin), as the AI-CAM's fragment has them.
BR2_TARGET_UBOOT_SPL=y
BR2_TARGET_UBOOT_SPL_NAME="spl/u-boot-spl.bin"
BR2_TARGET_UBOOT_FORMAT_BIN=y
BR2_TARGET_OPENSBI_INSTALL_JUMP_IMG=y

# The config starts from Buildroot's allnoconfig, so the console login is named
# here: root's login and a getty on the debug UART (UART0, ttyS0, 115200).
BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW=y
BR2_TARGET_ENABLE_ROOT_LOGIN=y
BR2_TARGET_GENERIC_GETTY=y
BR2_TARGET_GENERIC_GETTY_PORT="ttyS0"
BR2_TARGET_GENERIC_GETTY_BAUDRATE_115200=y
