# Every RV1126B board: the read-only root's EROFS, and the SD/MMC host the
# boards boot from built in, as the initramfs-less root needs it. The
# SDMMC0 controller is the dw_mmc with the rk3288 glue (the RV1126B's own
# compatible is not in 7.3.3's driver).
CONFIG_EROFS_FS=y
CONFIG_MMC=y
CONFIG_MMC_BLOCK=y
CONFIG_MMC_DW=y
CONFIG_MMC_DW_ROCKCHIP=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
