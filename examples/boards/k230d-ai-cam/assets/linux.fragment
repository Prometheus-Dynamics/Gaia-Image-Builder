# Mainline's riscv defconfig cut down for the K230D's 128 MB: U-Boot loads
# the kernel at 2 MiB and the dtb at 34 MiB, so Image must stay under 32 MiB.
# CONFIG_ARCH_ANDES is not set
# CONFIG_ARCH_ANLOGIC is not set
# CONFIG_ARCH_ESWIN is not set
# CONFIG_ARCH_MICROCHIP is not set
# CONFIG_ARCH_SIFIVE is not set
# CONFIG_ARCH_SOPHGO is not set
# CONFIG_ARCH_SPACEMIT is not set
# CONFIG_SOC_STARFIVE is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_TENSTORRENT is not set
# CONFIG_ARCH_THEAD is not set
# CONFIG_ARCH_ULTRARISC is not set
# CONFIG_ARCH_VIRT is not set
# CONFIG_DRM is not set
# CONFIG_KVM is not set
# CONFIG_MODULES is not set
CONFIG_ARCH_CANAAN=y
CONFIG_COMMON_CLK_K230=y
CONFIG_RESET_K230=y
CONFIG_PINCTRL_K230=y
CONFIG_PHY_CANAAN_USB=y
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_SDHCI_OF_DWCMSHC=y
CONFIG_EXT4_FS=y
CONFIG_EROFS_FS=y
# The board's only network: a USB gadget (g_ether, CDC ECM and RNDIS) on the
# USB-C port.
CONFIG_USB=y
CONFIG_USB_DWC2=y
CONFIG_USB_DWC2_PERIPHERAL=y
CONFIG_USB_GADGET=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
# The CMA area and heaps for frames in place, as on the K230D Zero.
CONFIG_CMA=y
CONFIG_DMA_CMA=y
CONFIG_CMA_SIZE_SEL_MBYTES=y
CONFIG_CMA_SIZE_MBYTES=16
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
