diff -ruN uboot-c/arch/riscv/dts/k230d-ai-cam.dts uboot-d/arch/riscv/dts/k230d-ai-cam.dts
--- a/arch/riscv/dts/k230d-ai-cam.dts	1969-12-31 16:00:00.000000000 -0800
+++ b/arch/riscv/dts/k230d-ai-cam.dts	2026-11-16 03:06:15.104545153 -0700
@@ -0,0 +1,88 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * CanMV K230D AI-CAM, U-Boot (SPL and U-Boot) device tree. Our own file, not
+ * the BPI Zero's: the Zero's iomux table (k230d_canmv_bpi.dts) writes nearly
+ * every pad before relocation, and that board's bank voltages are not this
+ * board's. This file writes ONLY the pads a console boot from SD needs:
+ *   UART0      IO38 (TXD), IO39 (RXD)
+ *   SDIO1      IO26 (clk), IO27 (cmd), IO28-IO31 (d0-d3)
+ * and no others: no drop_pins, no other pinctrl-single entries.
+ *
+ * INPUT CONTRACT. Each of the 8 pad entries below takes a raw 32-bit register
+ * value plus the label of the dump it came from (Lemnos's read-only dump of the
+ * pad registers). A value counts as ROM-proven for this table only if its SEL
+ * field (bits 11 and up, k230_evb.h:48) shows the function the entry needs in
+ * that dump: SEL = 1 for the SDIO1 pads IO26-IO31 as the SDK sets them
+ * (k230d_canmv_bpi.dts:124-129), and SEL = 1 for UART0 IO38/IO39
+ * (k230d_canmv_bpi.dts:144-145). Otherwise the value is a reset default and its
+ * bank bit proves nothing.
+ * The ROM sets up pads only for the boot source it tries. A session entered
+ * with KEY held tries MMC0, not SD, so the labelled dump that counts for SD is
+ * the no-KEY reset in which the ROM attempted SD. Each entry records that label.
+ * Until a labelled SD-attempt dump or the AI-CAM schematic gives the two bank
+ * voltages, the #error guards below keep the build refused.
+ *
+ * Every pad entry below is copied from the SDK's k230d_canmv_bpi.dts, so its
+ * register value is the SDK's, with one exception: the bank-voltage field
+ * (MSC, bit 9 of each pad register, k230_evb.h:46) is the macro below, which
+ * this file does NOT define. The pinctrl-single driver writes the whole
+ * register (function-mask 0xffffffff, k230.dtsi:233-234), so every entry sets
+ * its bank's MSC bit whether or not the ROM left it that way. The SDK documents
+ * no ROM default for these pads.
+ *
+ * The build refuses until both macros are defined (#error below). Define them
+ * from the AI-CAM schematic, or from Lemnos's pad dump of the real board, and
+ * never default them to 3V3 here: a wrong bank voltage damages the chip.
+ *   K230_MSC_3V3 = 0, K230_MSC_1V8 = 1 (k230_evb.h:29-30).
+ */
+
+/dts-v1/;
+#include <dt-bindings/pinctrl/k230_evb.h>
+
+#ifndef BANK_VOLTAGE_IO26_IO37
+#error "UNKNOWN: AI-CAM bank voltage for IO26-IO37 (SDIO1). Fill from the AI-CAM schematic or Lemnos's pad dump; do not default."
+#endif
+#ifndef BANK_VOLTAGE_IO38_IO49
+#error "UNKNOWN: AI-CAM bank voltage for IO38-IO49 (UART0). Fill from the AI-CAM schematic or Lemnos's pad dump; do not default."
+#endif
+
+#include "k230d.dtsi"
+
+/ {
+	model = "CanMV K230D AI-CAM";
+	compatible = "canaan,canmv-k230d-ai-cam", "kendryte,k230d";
+
+	memory@0 {
+		device_type = "memory";
+		reg = <
+				0x0 0 0x0 0x7000000  /*MEM_LINUX_SYS*/
+				0x0 0x7000000 0 0x1000000  /*nuttx*/
+			  >;
+	};
+};
+
+&mmc1 {
+	status = "okay";
+};
+
+&iomux {
+	pinctrl-names = "default";
+	pinctrl-0 = <&pins>;
+
+	pins: iomux_pins {
+		u-boot,dm-pre-reloc;
+		pinctrl-single,pins = <
+		// SD (SDIO1): copied from k230d_canmv_bpi.dts:124-129
+		(IO26) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO26_IO37<<MSC | 0<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST )//clk
+		(IO27) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO26_IO37<<MSC | 1<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST ) //cmd
+		(IO28) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO26_IO37<<MSC | 1<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST ) //d0
+		(IO29) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO26_IO37<<MSC | 1<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST ) //d1
+		(IO30) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO26_IO37<<MSC | 1<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST ) //d2
+		(IO31) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO26_IO37<<MSC | 1<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST ) //d3
+
+		// UART0: copied from k230d_canmv_bpi.dts:144-145
+		(IO38) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO38_IO49<<MSC | 0<<IE | 1<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST )
+		(IO39) ( 1<<SEL | 0<<SL | BANK_VOLTAGE_IO38_IO49<<MSC | 1<<IE | 0<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST ) //UART0_RXD
+		>;
+	};
+};
