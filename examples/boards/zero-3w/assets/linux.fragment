# USB gadget network on the OTG port (g_ether: CDC ECM and RNDIS), with the
# OTG controller in peripheral mode (rk3566-radxa-zero-3w-gadget.dts).
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3_DUAL_ROLE=y
CONFIG_USB_ETH=y
CONFIG_USB_ETH_RNDIS=y
# USB Ethernet adapters on the host port (eth0).
CONFIG_USB_USBNET=y
CONFIG_USB_RTL8152=y
CONFIG_USB_NET_AX88179_178A=y
CONFIG_USB_NET_CDCETHER=y
CONFIG_EROFS_FS=y
