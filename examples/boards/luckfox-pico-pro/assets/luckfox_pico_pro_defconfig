# Luckfox Pico Pro (RV1106G2, 128 MB SPI-NAND): upstream Buildroot with the
# Luckfox SDK's uClibc toolchain, vendor 5.10 kernel and vendor U-Boot.
# The toolchain path, kernel tree and post-image arguments come from the
# build's luckfox source (config_overrides, override_srcdirs).
# Written, untested on board.
BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_NEON_VFPV4=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM=y
BR2_TOOLCHAIN_EXTERNAL_PREINSTALLED=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_PREFIX="arm-rockchip830-linux-uclibcgnueabihf"
BR2_TOOLCHAIN_EXTERNAL_GCC_8=y
BR2_TOOLCHAIN_EXTERNAL_HEADERS_5_10=y
BR2_TOOLCHAIN_EXTERNAL_CUSTOM_UCLIBC=y
BR2_TOOLCHAIN_EXTERNAL_WCHAR=y
BR2_TOOLCHAIN_EXTERNAL_HAS_SSP=y
BR2_TOOLCHAIN_EXTERNAL_CXX=y
BR2_TARGET_GENERIC_HOSTNAME="luckfox"
BR2_TARGET_GENERIC_ISSUE="Welcome to the Luckfox Pico Pro"
BR2_TARGET_GENERIC_GETTY_PORT="ttyFIQ0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_SYSTEM_DHCP="eth0"
# SSH. The root is read-only, so its host keys are made on each boot
# (/etc/dropbear links to /var/run/dropbear).
BR2_PACKAGE_DROPBEAR=y
# The root is a read-only squashfs; /data is UBIFS (overlay/etc/fstab).
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.10.160"
BR2_LINUX_KERNEL_DEFCONFIG="luckfox_rv1106_linux"
BR2_LINUX_KERNEL_ZIMAGE=y
# The 5.10 kernel's extract-cert needs openssl/engine.h, which current
# host OpenSSL 3 packages leave out: build it against Buildroot's.
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rv1106g-luckfox-pico-pro-max"
# The slot root: EROFS with LZ4HC, which the 5.10 kernel's LZ4 decoder reads
# (assets/linux.fragment). Gaia appends its dm-verity tree with veritysetup
# from host-cryptsetup. Reproducible, so the EROFS has a fixed time and a zero
# UUID: the same tree gives the same root hash in the slot environments.
BR2_REPRODUCIBLE=y
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC_LEVEL=12
BR2_PACKAGE_HOST_CRYPTSETUP=y
