# A/B slots in env.img (see ../README in examples/boards): two 128K copies of
# the environment, and the variables the slot environments set.
CONFIG_ENV_NAND_SIZE=0x20000
CONFIG_ENV_NAND_OFFSET_REDUND=0x20000
CONFIG_ENVF_LIST="blkdevparts mtdparts sys_bootargs app reserved ipaddr serverip netmask gatewayip ethaddr bootcmd gaia_trial"
