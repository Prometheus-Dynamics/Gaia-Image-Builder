+void kd_vo_set_vtth_intr(bool status, uint32_t vpos)
+{
+    uint32_t reg = 0;
+
+    reg = (reg & ~(BIT_MASK(20))) | (status << 20);
+    if (status != 0)
+        reg = (reg & ~(GENMASK(12, 0))) | (vpos << 0);
