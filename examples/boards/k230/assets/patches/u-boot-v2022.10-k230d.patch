+/**
+ * @file      pufs_sp38d.c
+ * @brief     PUFsecurity SP38D API implementation
+ * @copyright 2020 PUFsecurity
+ */
+/* THIS SOFTWARE IS SUPPLIED BY PUFSECURITY ''AS IS'' AND ANY EXPRESS
+ * OR IMPLIED WARRANTIES, INCLUDING, BUT NOT LIMITED TO, THE IMPLIED
