+/**
+ * @file      pufs_rt.c
+ * @brief     PUFsecurity PUFrt API implementation
+ * @copyright 2020 PUFsecurity
+ */
+/* THIS SOFTWARE IS SUPPLIED BY PUFSECURITY ''AS IS'' AND ANY EXPRESS
