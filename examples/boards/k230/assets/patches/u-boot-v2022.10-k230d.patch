+
+static void device_disable(void)
+{
+    uint32_t value;
+
+    // disable ai power
+    if (readl((void*)0x9110302c) & 0x2)
+        writel(0x30001, (void*)0x91103028);
+    // disable vpu power
+    if (readl((void*)0x91103080) & 0x2)
+        writel(0x30001, (void*)0x9110307c);
+    // disable dpu power
+    if (readl((void*)0x9110310c) & 0x2)
+        writel(0x30001, (void*)0x91103108);
+    // disable disp power
+    if (readl((void*)0x91103040) & 0x2)
+        writel(0x30001, (void*)0x9110303c);
+    // check disable status
+    value = 1000000;
+    while ((!(readl((void*)0x9110302c) & 0x1) || !(readl((void*)0x91103080) & 0x1) ||
+        !(readl((void*)0x9110310c) & 0x1) || !(readl((void*)0x91103040) & 0x1)) && value)
+        value--;
+    // disable ai clk
+    value = readl((void*)0x91100008);
+    value &= ~((1 << 0));
+    writel(value, (void*)0x91100008);
+    // disable vpu clk
+    value = readl((void*)0x9110000c);
+    value &= ~((1 << 0));
+    writel(value, (void*)0x9110000c);
+    // disable dpu clk
+    value = readl((void*)0x91100070);
+    value &= ~((1 << 0));
+    writel(value, (void*)0x91100070);
+    // disable mclk
+    value = readl((void*)0x9110006c);
+    value &= ~((1 << 0) | (1 << 1) | (1 << 2));
+    writel(value, (void*)0x9110006c);
+}
+
+__weak void quick_boot_board_init(void)
+{
+	/* Nothing to do! */
+}
+//weak;
+int spl_board_init_f(void)
+{
+    int ret = 0;
+
+    device_disable();
+    g_bootmod = sysctl_boot_get_boot_mode();
+
+    record_boot_time_info_to_sram("ds");
+    dram_init();
+    record_boot_time_info_to_sram("dd");
+    /* Clear the BSS. */
+    //record_boot_time_info_to_sram("bs");
+    memset(__bss_start, 0, (ulong)&__bss_end - (ulong)__bss_start);
+    //record_boot_time_info_to_sram("be");
+
+
+
+    // /* load/boot image from boot device */
+    //if(quick_boot() == 1){//默认非快起；
+    if(quick_boot()){//默认快起
+        quick_boot_board_init();
+
+        //record_boot_time_info("ls");
+        ret += k230_img_load_boot_sys(BOOT_SYS_AUTO);
+    }
+
+    ret = k230_img_load_boot_sys(BOOT_SYS_UBOOT);
+    if(ret ){
+        printf("uboot boot failed ret=0x%x \n", ret);
+        enter_to_usb_burn_mode();
+    }
+    //while(1);
+    //board_init_r(NULL, 0);
+    return ret;
+}
+
+//1 快起 other：非快起
+int quick_boot(void)
+{
+    int ret = 1 ;
+    #if defined(CONFIG_LINUX_RUN_CORE_ID) && (CONFIG_LINUX_RUN_CORE_ID == 1)
+    return 0; //非快起，uboot运行在大核core1;
+    #endif
+
+    if((g_bootmod == SYSCTL_BOOT_SDIO0) || (g_bootmod == SYSCTL_BOOT_SDIO1)){
+        if(mmc_init_device(mmc_get_env_dev()))
+            return 0;//正常boot；
+    }
+
+    env_init();
+    env_load();
+    ret  = env_get_yesno("quick_boot");
+    return ret;
+}
