+
+#define reg_write( addr,v)                       \
+    {                                         \
+        writel(v, (volatile void __iomem *)addr); \
+    }
+
+
+#define reg_read( addr,v)                       \
+    {                                         \
+       v =readl((const volatile void __iomem *) addr );  \
+    }
+
+#define  BOOT_REG_BASE   (0x91102000)
