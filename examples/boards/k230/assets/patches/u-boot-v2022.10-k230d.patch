+uint32_t be2le(uint32_t var)
+{
+    return (((0xff000000 & var) >> 24) |
+            ((0x00ff0000 & var) >> 8) |
+            ((0x0000ff00 & var) << 8) |
+            ((0x000000ff & var) << 24));
+}
