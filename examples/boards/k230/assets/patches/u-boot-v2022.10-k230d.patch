+	drop_pins: drop_pins {
+		u-boot,dm-pre-reloc;
+		pinctrl-single,pins = <
+		(IO9 ) ( 0<<SEL | 0<<SL | 0 <<MSC | 0<<IE | 0<<OE | 0<<PU | 0<<PD | 7<<DS | 1<<ST )
