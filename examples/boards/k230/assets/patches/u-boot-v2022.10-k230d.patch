+__weak  sysctl_boot_mode_e sysctl_boot_get_boot_mode(void)
+{
+    switch(REG_SOC_BOOT_CTL & 0x3)/*bit0~1*/
+    {        
+        case 1:
+            return SYSCTL_BOOT_NANDFLASH;
+        case 2:
+            return SYSCTL_BOOT_SDIO0;
