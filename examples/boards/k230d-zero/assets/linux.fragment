# Contiguous memory: VGLite's own buffers (vg_lite_allocate) and the CMA
# dma-heap (/dev/dma_heap/linux,cma) both allocate from the one default CMA
# area, which the k230 defconfig makes 50% of RAM (64 MiB of 128).
#
# CONFIG_CMA_SIZE_MBYTES is the knob, and a `cma=<size>M` kernel argument
# overrides it at boot. 8 MiB holds four NV12 frames of the K230D Zero's
# sensor (1280x720: 1.32 MiB each, 5.3 MiB; 1280x800: 5.9 MiB), VGLite's two
# 128 KiB command buffers and its tessellation buffer, and about 2 MiB for
# VGLite staging buffers and other drivers' coherent allocations. Pages in
# the area that no one has allocated still serve Linux's movable memory.
CONFIG_CMA_SIZE_SEL_MBYTES=y
# CONFIG_CMA_SIZE_SEL_PERCENTAGE is not set
CONFIG_CMA_SIZE_MBYTES=8
# Contiguous dmabufs (a single scatter-list entry, which VGLite's dmabuf map
# needs) at /dev/dma_heap/linux,cma, and the system heap, as on the Rockchip
# boards.
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_CMA=y
CONFIG_DMABUF_HEAPS_SYSTEM=y
# /dev/mmz: nothing on the image uses it (Styx's K230 path and Daedalus take
# contiguous buffers from the CMA heap).
# CONFIG_K230_MMZ is not set
