# Filesystems the slot roots may use.
CONFIG_EROFS_FS=y
# The 5.10 vendor tree defaults WERROR=y; GCC 14 (Buildroot 2026.02) warns
# where the GCC 10 it was written for did not (dangling-pointer in
# kernel/locking/semaphore.c, for one).
# CONFIG_WERROR is not set
# Binutils 2.36 and later refuse the 5.10 tree's mix of ordered and
# unordered __patchable_function_entries sections (function tracer, its
# -fpatchable-function-entry): vmlinux would not link. A bring-up image
# does without the function tracer.
# CONFIG_FUNCTION_TRACER is not set
