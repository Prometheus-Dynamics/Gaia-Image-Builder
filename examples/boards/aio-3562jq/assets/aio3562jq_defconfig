# Firefly AIO-3562JQ (RK3562): upstream Buildroot with Firefly's vendor 5.10
# kernel (rk3562/firefly, through override_srcdirs) and vendor U-Boot, built
# by post-image.sh with rkbin's DDR init, SPL, BL31 and OP-TEE. Mainline has
# an RK3562 device tree base but no U-Boot and no board support yet.
# Written, untested on board.
BR2_aarch64=y
BR2_cortex_a53=y
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
# The vendor kernel is 5.10: the C library may not use newer syscalls.
BR2_KERNEL_HEADERS_5_10=y
BR2_TARGET_GENERIC_HOSTNAME="aio3562jq"
BR2_TARGET_GENERIC_ISSUE="Welcome to the AIO-3562JQ"
BR2_TARGET_GENERIC_GETTY_PORT="ttyFIQ0"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
BR2_SYSTEM_DHCP="eth0"
BR2_LINUX_KERNEL=y
# Firefly's 5.10.160 tree, cloned from the Gaia source (build.toml sets the
# URL and commit) so Buildroot applies the patch below; override_srcdirs
# skips patches.
BR2_LINUX_KERNEL_CUSTOM_GIT=y
BR2_LINUX_KERNEL_DEFCONFIG="firefly_linux"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="rockchip/rk3562-firefly-aio-3562jq"
BR2_LINUX_KERNEL_INSTALL_TARGET=y
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_DROPBEAR=y
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
BR2_PACKAGE_HOST_DTC=y
BR2_PACKAGE_HOST_PYTHON3=y
