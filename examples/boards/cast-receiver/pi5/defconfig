# Raspberry Pi 5 cast receiver: the board. The rest is
# external/cast.fragment. The [cpu] profile adds BR2_cortex_a76.
BR2_aarch64=y
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_AARCH64_GLIBC_STABLE=y
# Buildroot's Raspberry Pi kernel hash, and the external tree's package
# patches (gmrender-resurrect).
BR2_GLOBAL_PATCH_DIR="board/raspberrypi/patches $(BR2_EXTERNAL_CAST_PATH)/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y
BR2_OPTIMIZE_2=y
BR2_SHARED_LIBS=y

# Kernel: the Raspberry Pi 6.12 tree Buildroot's raspberrypi5_defconfig
# pins (its hash is in board/raspberrypi/patches/linux), with 4 KiB pages as
# Buildroot builds it (bcm2712_defconfig uses 16 KiB).
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL=y
BR2_LINUX_KERNEL_CUSTOM_TARBALL_LOCATION="$(call github,raspberrypi,linux,21b410140c47ffab5668399f6f143c7d7b935c8b)/linux-21b410140c47ffab5668399f6f143c7d7b935c8b.tar.gz"
BR2_LINUX_KERNEL_DEFCONFIG="bcm2712"
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_INTREE_DTS_NAME="broadcom/bcm2712-rpi-5-b broadcom/bcm2712d0-rpi-5-b broadcom/bcm2712-rpi-500"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="board/raspberrypi/linux-4k-page-size.fragment $(BR2_EXTERNAL_CAST_PATH)/linux/cast.fragment $(BR2_EXTERNAL_CAST_PATH)/linux/pi5.fragment"
BR2_LINUX_KERNEL_NEEDS_HOST_OPENSSL=y
BR2_PACKAGE_KMOD=y
BR2_PACKAGE_KMOD_TOOLS=y
BR2_PACKAGE_HOST_KMOD_XZ=y

# Firmware: the Pi 5 boots from its EEPROM; only the overlays are used,
# copied into the boot tree by the assembly.
BR2_PACKAGE_RPI_FIRMWARE=y
BR2_PACKAGE_RPI_FIRMWARE_INSTALL_DTB_OVERLAYS=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI=y
BR2_PACKAGE_BRCMFMAC_SDIO_FIRMWARE_RPI_WIFI=y
# post-build.sh and the board's name for it (its Wi-Fi files and video
# options). Both are here: the argument exists only once a script is set.
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_CAST_PATH)/post-build.sh"
BR2_ROOTFS_POST_SCRIPT_ARGS="pi5"

# No H.264 block on the BCM2712: FFmpeg decodes H.264 (and HEVC, for DLNA
# files) on the A76s, besides the audio.
# FFmpeg is enabled here, not only in cast.fragment: the decoder and parser
# lists exist only once it is, and the fragment is applied after this file.
BR2_PACKAGE_FFMPEG=y
BR2_PACKAGE_FFMPEG_DECODERS="h264 hevc aac aac_latm alac mp3 mp3float flac vorbis opus ac3 eac3 pcm_s16le pcm_s24le"
BR2_PACKAGE_FFMPEG_PARSERS="h264 hevc aac aac_latm mpegaudio flac vorbis opus ac3"
