From: Gaia cm4-cast-receiver example
Subject: [PATCH] gstreamer output: release the sinks when playback ends

Stop put playbin in READY, and end-of-stream and errors left it in
PLAYING or PAUSED. Sinks open their devices in NULL->READY and close
them in READY->NULL, so the renderer kept the display (kmssink is DRM
master while open) and the audio device after playback, and no other
player could use them.

Go to NULL on stop, at the end of the last stream, and on an error, and
report an error as a stop so the controller's state follows.
---
--- a/src/output_gstreamer.c	2026-10-31 22:56:52.367631283 -0700
+++ b/src/output_gstreamer.c	2026-10-31 22:56:52.409266012 -0700
@@ -162,7 +162,9 @@
 }
 
 static int output_gstreamer_stop(void) {
-	if (gst_element_set_state(player_, GST_STATE_READY) ==
+	// NULL, not READY: the sinks (kmssink, alsasink) close their devices
+	// only in READY->NULL, and other players need them.
+	if (gst_element_set_state(player_, GST_STATE_NULL) ==
 	    GST_STATE_CHANGE_FAILURE) {
 		return -1;
 	} else {
@@ -292,8 +294,11 @@
 			if (play_trans_callback_) {
 				play_trans_callback_(PLAY_STARTED_NEXT_STREAM);
 			}
-		} else if (play_trans_callback_) {
-			play_trans_callback_(PLAY_STOPPED);
+		} else {
+			gst_element_set_state(player_, GST_STATE_NULL);
+			if (play_trans_callback_) {
+				play_trans_callback_(PLAY_STOPPED);
+			}
 		}
 		break;
 
@@ -308,6 +313,10 @@
 		g_error_free(err);
 		g_free(debug);
 
+		gst_element_set_state(player_, GST_STATE_NULL);
+		if (play_trans_callback_) {
+			play_trans_callback_(PLAY_STOPPED);
+		}
 		break;
 	}
 	case GST_MESSAGE_STATE_CHANGED: {
