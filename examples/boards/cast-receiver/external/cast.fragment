# Cast receiver: everything but the board (CPU, kernel, firmware, FFmpeg
# decoders), as a Buildroot config fragment applied after a board defconfig.

# System: BusyBox init, mdev (module coldplug), read-only root, no getty
# (cast.txt's DEBUG_SHELL=1 starts one on the serial console).
BR2_TARGET_GENERIC_HOSTNAME="cast"
BR2_TARGET_GENERIC_ISSUE="cast receiver"
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_MDEV=y
# BR2_TARGET_GENERIC_REMOUNT_ROOTFS_RW is not set
# BR2_TARGET_GENERIC_GETTY is not set
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_CAST_PATH)/rootfs-overlay"
# BR2_TARGET_ENABLE_ROOT_LOGIN is not set

# Root filesystem: EROFS, lz4hc (fast to read at boot).
BR2_TARGET_ROOTFS_EROFS=y
BR2_TARGET_ROOTFS_EROFS_LZ4HC=y
BR2_TARGET_ROOTFS_EROFS_DEDUPE=y
BR2_TARGET_ROOTFS_EROFS_FRAGMENTS=y
BR2_TARGET_ROOTFS_EROFS_ZTAILPACKING=y
# BR2_TARGET_ROOTFS_TAR is not set
BR2_PACKAGE_HOST_DOSFSTOOLS=y
BR2_PACKAGE_HOST_MTOOLS=y

# Networking: Ethernet DHCP (BusyBox udhcpc), optional Wi-Fi.
BR2_PACKAGE_WPA_SUPPLICANT=y
BR2_PACKAGE_WPA_SUPPLICANT_NL80211=y
BR2_PACKAGE_WPA_SUPPLICANT_PASSPHRASE=y

# mDNS: AirPlay and DLNA discovery. UxPlay registers through avahi's dns_sd
# compatibility library, which talks to avahi-daemon over D-Bus.
BR2_PACKAGE_DBUS=y
BR2_PACKAGE_AVAHI=y
BR2_PACKAGE_AVAHI_DAEMON=y
BR2_PACKAGE_AVAHI_LIBDNSSD_COMPATIBILITY=y
# BR2_PACKAGE_AVAHI_DEFAULT_SERVICES is not set

# Audio: HDMI through alsa-lib's vc4-hdmi card config (IEC958 framing).
BR2_PACKAGE_ALSA_LIB=y

# GStreamer: no debug log, no registry rebuilds at run time beyond the first.
BR2_PACKAGE_GSTREAMER1=y
# BR2_PACKAGE_GSTREAMER1_GST_DEBUG is not set
# BR2_PACKAGE_GSTREAMER1_TRACE is not set
BR2_PACKAGE_GSTREAMER1_INSTALL_TOOLS=y
BR2_PACKAGE_GST1_PLUGINS_BASE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_APP=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_ALSA=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIOCONVERT=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORESAMPLE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_AUDIORATE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VIDEOCONVERTSCALE=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_PLAYBACK=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_TYPEFIND=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_VOLUME=y
BR2_PACKAGE_GST1_PLUGINS_BASE_PLUGIN_OGG=y
# BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_OPENGL is not set
# BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_GLES2 is not set
# BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_GLX is not set
# BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_EGL is not set
# BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_X11 is not set
# BR2_PACKAGE_GST1_PLUGINS_BASE_LIB_OPENGL_WAYLAND is not set
BR2_PACKAGE_GST1_PLUGINS_GOOD=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_V4L2_PROBE=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_DEBUGUTILS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ISOMP4=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_MATROSKA=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUDIOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AUTODETECT=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ID3DEMUX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_ICYDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_WAVPARSE=y
# BR2_PACKAGE_GST1_PLUGINS_GOOD_PLUGIN_AVI is not set
BR2_PACKAGE_GST1_PLUGINS_BAD=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_KMS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_VIDEOPARSERS=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_MPEGTSDEMUX=y
BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_CURL=y
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_GL is not set
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WAYLAND is not set
# BR2_PACKAGE_GST1_PLUGINS_BAD_PLUGIN_WPE is not set

# Audio decoders (AirPlay AAC-ELD and ALAC; DLNA's common formats) through
# gst-libav, with an FFmpeg cut down to them. Each board's defconfig sets
# BR2_PACKAGE_FFMPEG_DECODERS and _PARSERS (the CM4 decodes video in hardware; the Pi 5
# decodes H.264 in software).
BR2_PACKAGE_GST1_LIBAV=y
BR2_PACKAGE_FFMPEG=y
# BR2_PACKAGE_FFMPEG_FFMPEG is not set
# BR2_PACKAGE_FFMPEG_FFPROBE is not set
BR2_PACKAGE_FFMPEG_ENCODERS=""
BR2_PACKAGE_FFMPEG_MUXERS=""
BR2_PACKAGE_FFMPEG_DEMUXERS=""
BR2_PACKAGE_FFMPEG_BSFS=""
BR2_PACKAGE_FFMPEG_PROTOCOLS=""
BR2_PACKAGE_FFMPEG_FILTERS=""
# BR2_PACKAGE_FFMPEG_INDEVS is not set
# BR2_PACKAGE_FFMPEG_OUTDEVS is not set

# The receivers and the idle screen.
BR2_PACKAGE_UXPLAY=y
BR2_PACKAGE_GMRENDER_RESURRECT=y
BR2_PACKAGE_CASTIDLE=y

# The overlay brings its own network script; the root is read-only, so no
# random seed is saved across boots (the kernel's RNG is seeded by the SoC's
# hardware RNG).
# BR2_PACKAGE_IFUPDOWN_SCRIPTS is not set
# BR2_PACKAGE_URANDOM_SCRIPTS is not set
