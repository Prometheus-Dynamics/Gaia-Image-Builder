#!/bin/sh
# Ethernet by DHCP, always; Wi-Fi as well when cast.txt names a network.
# udhcpc runs in the background from the start (boot never waits for a lease)
# and keeps retrying every 5 s, so a cable plugged in later gets an address.

. /run/cast/env

dhcp() {
	udhcpc -f -S -A 5 -i "$1" -x "hostname:$(hostname)" -p "/run/udhcpc.$1.pid" </dev/null >/dev/null 2>&1 &
}

start() {
	ip link set lo up
	ip link set eth0 up 2>/dev/null && dhcp eth0

	[ -n "$WIFI_SSID" ] || return 0
	# brcmfmac is a module (loaded by mdev): wait for the interface.
	for i in $(seq 50); do
		[ -d /sys/class/net/wlan0 ] && break
		sleep 0.1
	done
	[ -d /sys/class/net/wlan0 ] || { echo "castnet: no wlan0"; return 0; }
	umask 077
	{
		echo "ctrl_interface=/run/wpa_supplicant"
		echo "country=$WIFI_COUNTRY"
		echo "network={"
		printf '\tssid="%s"\n' "$WIFI_SSID"
		if [ -n "$WIFI_PSK" ]; then
			printf '\tpsk="%s"\n' "$WIFI_PSK"
			printf '\tkey_mgmt=WPA-PSK WPA-PSK-SHA256 SAE\n\tieee80211w=1\n'
		else
			printf '\tkey_mgmt=NONE\n'
		fi
		echo "}"
	} > /run/cast/wpa_supplicant.conf
	ip link set wlan0 up
	wpa_supplicant -B -i wlan0 -D nl80211 -c /run/cast/wpa_supplicant.conf -P /run/wpa_supplicant.pid
	dhcp wlan0
}

stop() {
	for pid in /run/udhcpc.*.pid /run/wpa_supplicant.pid; do
		[ -f "$pid" ] && kill "$(cat "$pid")" 2>/dev/null
	done
}

case "$1" in
	start) start ;;
	stop) stop ;;
	*) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
