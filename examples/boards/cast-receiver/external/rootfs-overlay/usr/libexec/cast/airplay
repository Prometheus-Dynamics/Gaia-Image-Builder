#!/bin/sh
# AirPlay mirroring and audio (respawned by init).
#
#   $UXPLAY_VIDEO        the board's H.264 decoder (/etc/cast/board.env);
#   -srgb no             no full-range RGB conversion (it would copy frames);
#   -vs kmssink          scan out on HDMI; it opens the display only while a
#                        client streams (patched UxPlay), never modesets;
#   -nofreeze -nohold    the idle screen returns when a client stops, and a
#                        new client takes over from the current one.
. /etc/cast/board.env
. /run/cast/env
if [ "$AIRPLAY" != 1 ]; then
	exec sleep 2147483647
fi
export HOME=/run/cast
# shellcheck disable=SC2086 # UXPLAY_VIDEO is a list of options
set -- -n "$NAME" -nh $UXPLAY_VIDEO -srgb no -vs kmssink \
	-as alsasink -s 1920x1080@60 -fps 60 -nofreeze -nohold
[ -n "$AIRPLAY_PASSWORD" ] && set -- "$@" -pw "$AIRPLAY_PASSWORD"
# shellcheck disable=SC2086 # UXPLAY_EXTRA is a list of options
uxplay "$@" $UXPLAY_EXTRA 2>&1 | logger -t uxplay
sleep 2
