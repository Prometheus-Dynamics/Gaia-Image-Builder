#!/bin/sh
# Read /boot/cast.txt (KEY=value lines) into /run/cast/env, with defaults,
# and set the hostname from the board's serial number.

ENV=/run/cast/env

parse() {
	# Keep KEY=value lines with known keys; strip CRs (files edited on Windows).
	tr -d '\r' < "$1" | sed -n 's/^[[:space:]]*\(NAME\|WIFI_SSID\|WIFI_PSK\|WIFI_COUNTRY\|AIRPLAY\|DLNA\|AIRPLAY_PASSWORD\|UXPLAY_EXTRA\|DEBUG_SHELL\)[[:space:]]*=[[:space:]]*\(.*\)$/\1=\2/p'
}

quote() {
	# Single-quote a value for the shell.
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/'\\\\''/g")"
}

start() {
	mkdir -p /run/cast
	serial=$(tr -d '\0' < /proc/device-tree/serial-number 2>/dev/null | tail -c 8)
	[ -n "$serial" ] || serial=00000000

	NAME="" WIFI_SSID="" WIFI_PSK="" WIFI_COUNTRY="US" AIRPLAY=1 DLNA=1
	AIRPLAY_PASSWORD="" UXPLAY_EXTRA="" DEBUG_SHELL=0
	if [ -r /boot/cast.txt ]; then
		parse /boot/cast.txt > /run/cast/raw
		while IFS='=' read -r key value; do
			eval "$key=\$value"
		done < /run/cast/raw
		rm -f /run/cast/raw
	fi
	[ -n "$NAME" ] || NAME="Cast-$serial"

	{
		for key in NAME WIFI_SSID WIFI_PSK WIFI_COUNTRY AIRPLAY DLNA AIRPLAY_PASSWORD UXPLAY_EXTRA DEBUG_SHELL; do
			eval "value=\$$key"
			echo "$key=$(quote "$value")"
		done
		echo "SERIAL=$serial"
	} > "$ENV"

	hostname "cast-$serial"
	echo "cast-$serial" > /run/cast/hostname
}

case "$1" in
	start) start ;;
	stop) ;;
	*) echo "Usage: $0 {start|stop}"; exit 1 ;;
esac
