# Cast receiver changes on top of bcm2711_defconfig.
CONFIG_LOCALVERSION="-cast"

# The read-only root (EROFS, lz4) is mounted by the kernel, without an initramfs.
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_XATTR=y
# The boot partition (vfat's default iocharset) is mounted before modules load.
CONFIG_NLS_ISO8859_1=y

# Display: vc4 KMS with fbdev emulation for the idle screen (castidle draws
# into /dev/fb0), and no framebuffer console or logo on HDMI.
CONFIG_DRM_VC4=m
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB_DEVICE=y
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_LOGO is not set
# The 3D GPU is unused (no Mesa): kmssink scans decoded frames out directly.
# CONFIG_DRM_V3D is not set

# Video: the VideoCore H.264 decoder (bcm2835-codec, V4L2 stateful m2m) and
# the HEVC block (stateless).
CONFIG_VIDEO_CODEC_BCM2835=m
CONFIG_VIDEO_RPI_HEVC_DEC=m

# Not needed by an HDMI cast receiver.
# CONFIG_BT is not set
# CONFIG_CAN is not set
# CONFIG_NFC is not set
# CONFIG_IEEE802154 is not set
# CONFIG_6LOWPAN is not set
