# Every RK35xx board: the read-only root's EROFS, and what the arm64
# defconfig builds as modules that these boards need at boot, built in:
# the GMAC (stmmac, dwmac-rockchip; the ROCK 5C's and ZERO 3E's RTL8211F
# PHY is built in already) for DHCP on eth0, and the Naneng combo PHY
# behind USB 3 and PCIe.
CONFIG_EROFS_FS=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_ROCKCHIP=y
CONFIG_PHY_ROCKCHIP_NANENG_COMBO_PHY=y
