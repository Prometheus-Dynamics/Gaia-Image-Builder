--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -5,6 +5,15 @@
 
 menu "Misc devices"
 
+config GAIA_FW_MAILBOX
+	bool "Gaia: the Raspberry Pi firmware mailbox stand-in (QEMU board profile)"
+	depends on OF
+	help
+	  /dev/vcio for the board-like QEMU profile of Gaia's
+	  scripts/qemu-rpi-slots.sh: the property mailbox's reboot order
+	  and boot count tags, kept in a page the runner reads. Binds only
+	  to a "gaia,firmware-mailbox" node. Never on a board.
+
 config SENSORS_LIS3LV02D
 	tristate
 	depends on INPUT
--- a/drivers/misc/Makefile
