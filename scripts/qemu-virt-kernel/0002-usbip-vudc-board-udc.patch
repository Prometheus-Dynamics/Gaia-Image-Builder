+/*
+ * The link: a vsock stream to the host's port, then the same attach as a
+ * socket written to usbip_sockfd. Retried each second until it is up; the
+ * host side relays it to a stock host's vhci_hcd.
+ */
+void vudc_link_work(struct work_struct *work)
+{
+	struct vudc *udc = container_of(to_delayed_work(work), struct vudc, link);
+	struct sockaddr_vm addr = {
+		.svm_family = AF_VSOCK,
+		.svm_cid = VMADDR_CID_HOST,
+		.svm_port = udc->vsock_port,
+	};
+	struct socket *sock;
+	struct file *file;
+	int ret;
+
+	if (!udc->pullup || udc->connected)
+		return;
+	ret = sock_create_kern(&init_net, AF_VSOCK, SOCK_STREAM, 0, &sock);
+	if (ret)
+		goto again;
+	ret = kernel_connect(sock, (struct sockaddr_unsized *)&addr, sizeof(addr), 0);
+	if (ret) {
+		sock_release(sock);
+		goto again;
+	}
+	/* A file, so that vudc_shutdown's sockfd_put releases it. */
+	file = sock_alloc_file(sock, 0, NULL);
+	if (IS_ERR(file)) {
+		ret = PTR_ERR(file);
+		goto again;
+	}
+	mutex_lock(&udc->ud.sysfs_lock);
+	ret = vudc_attach(udc, sock);
+	mutex_unlock(&udc->ud.sysfs_lock);
+	if (ret) {
+		fput(file);
+		goto again;
+	}
+	dev_info(&udc->pdev->dev, "linked to the host over vsock port %u\n", udc->vsock_port);
+	return;
+again:
+	dev_dbg(&udc->pdev->dev, "vsock link: %d, again in 1 s\n", ret);
+	if (udc->pullup)
+		mod_delayed_work(system_dfl_wq, &udc->link, HZ);
+}
