+/*
+ * Starts USB/IP on a connected stream socket, with ud.sysfs_lock held. On
+ * success the socket is the UDC's (vudc_shutdown puts it); on failure it is
+ * still the caller's.
+ */
+int vudc_attach(struct vudc *udc, struct socket *socket)
+{
+	struct device *dev = &udc->pdev->dev;
+	struct task_struct *tcp_rx, *tcp_tx;
+	unsigned long flags;
+
+	spin_lock_irqsave(&udc->lock, flags);
+	/* Don't export what we don't have */
+	if (!udc->driver || !udc->pullup) {
+		spin_unlock_irqrestore(&udc->lock, flags);
+		dev_err(dev, "gadget not bound");
+		return -ENODEV;
+	}
+	if (udc->connected) {
+		spin_unlock_irqrestore(&udc->lock, flags);
+		dev_err(dev, "Device already connected");
+		return -EBUSY;
+	}
+	spin_lock(&udc->ud.lock);
+	if (udc->ud.status != SDEV_ST_AVAILABLE) {
+		spin_unlock(&udc->ud.lock);
+		spin_unlock_irqrestore(&udc->lock, flags);
+		return -EINVAL;
+	}
+	spin_unlock(&udc->ud.lock);
+	spin_unlock_irqrestore(&udc->lock, flags);
+
+	if (socket->type != SOCK_STREAM) {
+		dev_err(dev, "Expecting SOCK_STREAM - found %d", socket->type);
+		return -EINVAL;
+	}
+
+	tcp_rx = kthread_create(&v_rx_loop, &udc->ud, "vudc_rx");
+	if (IS_ERR(tcp_rx))
+		return -EINVAL;
+	tcp_tx = kthread_create(&v_tx_loop, &udc->ud, "vudc_tx");
+	if (IS_ERR(tcp_tx)) {
+		kthread_stop(tcp_rx);
+		return -EINVAL;
+	}
+
+	/* get task structs now */
+	get_task_struct(tcp_rx);
+	get_task_struct(tcp_tx);
+
+	/* lock and update udc->ud state */
+	spin_lock_irqsave(&udc->lock, flags);
+	spin_lock(&udc->ud.lock);
+
+	udc->ud.tcp_socket = socket;
+	udc->ud.tcp_rx = tcp_rx;
+	udc->ud.tcp_tx = tcp_tx;
+	udc->ud.status = SDEV_ST_USED;
+
+	spin_unlock(&udc->ud.lock);
+
+	ktime_get_ts64(&udc->start_time);
+	v_start_timer(udc);
+	udc->connected = 1;
+
+	spin_unlock_irqrestore(&udc->lock, flags);
+
+	wake_up_process(udc->ud.tcp_rx);
+	wake_up_process(udc->ud.tcp_tx);
+	return 0;
+}
