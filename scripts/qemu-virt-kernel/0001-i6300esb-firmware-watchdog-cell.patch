+/*
+ * Gaia (the board-like QEMU profile): a firmware-armed watchdog in a board's
+ * shape. When the device tree has a node compatible "gaia,firmware-watchdog"
+ * (at the path the board's own watchdog node has), the watchdog is
+ * registered on a child of that node's platform device, a "bcm2835-wdt"
+ * device with no of_node of its own, as bcm2835-pm's MFD cell is on the
+ * BCM2712. The child takes no driver. The watchdog starts at probe with the
+ * node's timeout-sec and is marked WDOG_HW_RUNNING, as bcm2835_wdt marks a
+ * watchdog the firmware armed, so the watchdog core feeds it until it is
+ * opened (CONFIG_WATCHDOG_OPEN_TIMEOUT) and not after the last close.
+ * The node's gaia,time-scale-percent (100 when absent) stretches every
+ * hardware countdown, for a guest that runs slower than the board: the
+ * timeouts userspace asks for and reads stay as asked.
+ * The node can also give the board watchdog's own facts: gaia,identity
+ * (the identity userspace reads) and gaia,max-hw-heartbeat-ms (the
+ * longest countdown its hardware takes; the watchdog then has no
+ * maximum timeout and the core feeds the hardware within it, as
+ * bcm2835_wdt's has none and is fed within 15999 ms).
+ * Returns 1 when the shape is made, 0 when the tree asks for none.
+ */
+static int esb_cell(struct esb_dev *edev)
+{
+	struct device_node *np;
+	struct platform_device *parent, *cell;
+	const char *identity;
+	u32 timeout, hw_ms;
+	int ret;
+
+	np = of_find_compatible_node(NULL, NULL, "gaia,firmware-watchdog");
+	if (!np)
+		return 0;
+	parent = of_find_device_by_node(np);
+	if (!parent) {
+		of_node_put(np);
+		return -EPROBE_DEFER;
+	}
+	if (!of_property_read_u32(np, "timeout-sec", &timeout) &&
+	    timeout >= ESB_HEARTBEAT_MIN && timeout <= ESB_HEARTBEAT_MAX)
+		edev->wdd.timeout = timeout;
+	if (of_property_read_u32(np, "gaia,time-scale-percent", &edev->scale) ||
+	    edev->scale < 100 || edev->scale > 10000)
+		edev->scale = 100;
+	if (!of_property_read_string(np, "gaia,identity", &identity)) {
+		edev->info = *edev->wdd.info;
+		strscpy(edev->info.identity, identity, sizeof(edev->info.identity));
+		edev->wdd.info = &edev->info;
+	}
+	if (!of_property_read_u32(np, "gaia,max-hw-heartbeat-ms", &hw_ms) &&
+	    hw_ms >= ESB_HEARTBEAT_MIN * 1000 && hw_ms <= ESB_HEARTBEAT_MAX * 1000) {
+		edev->hw_ms = hw_ms;
+		edev->wdd.max_hw_heartbeat_ms = hw_ms;
+		edev->wdd.max_timeout = 0;
+	}
+	of_node_put(np);
+
+	cell = platform_device_alloc("bcm2835-wdt", PLATFORM_DEVID_NONE);
+	if (!cell) {
+		put_device(&parent->dev);
+		return -ENOMEM;
+	}
+	cell->dev.parent = &parent->dev;
+	put_device(&parent->dev);
+	ret = device_set_driver_override(&cell->dev, "gaia,none");
+	if (!ret)
+		ret = platform_device_add(cell);
+	if (ret) {
+		platform_device_put(cell);
+		return ret;
+	}
+	edev->cell = cell;
+	edev->wdd.parent = &cell->dev;
+	return 1;
+}
